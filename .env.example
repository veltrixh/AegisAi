# ==============================================================================
# AEGIS AI-Vuln-Scanner Configuration
# ==============================================================================

# Application Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Persistence (SQLite for local dev, PostgreSQL for scale)
DATABASE_URL=sqlite:///vuln_scanner.db

# Scanner Concurrency & Rate Limiting Controls
DEFAULT_TIMEOUT=10.0
DEFAULT_CONCURRENCY=5
DEFAULT_RATE_LIMIT=15.0
ALLOW_LOCAL_TARGETS=true

# AI Provider Configuration (Optional - Offline deterministic fallback is active if omitted)
# Supported values: none | openai | gemini | ollama | local
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Frontend build setting (set in Netlify, not in the backend runtime)
# VITE_API_URL=https://your-aegis-api.onrender.com

# Target Scope Restrictions (Disallowed CIDRs / Domains in production)
DISALLOWED_METADATA_IPS=169.254.169.254,metadata.google.internal
